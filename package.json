{
  "name": "tracebeam",
  "version": "1.3.0",
  "description": "Lightweight TypeScript tracing SDK with async measurements, runtime event tracking, custom transports, and a browser debug overlay.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanja969/tracebeam.git"
  },
  "homepage": "https://github.com/Sanja969/tracebeam#readme",
  "bugs": {
    "url": "https://github.com/Sanja969/tracebeam/issues"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENCE",
    "demoex.gif"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "prepublishOnly": "npm run build",
    "test": "vitest --environment jsdom"
  },
  "keywords": [
    "typescript",
    "tracing",
    "sdk",
    "observability",
    "monitoring",
    "performance",
    "events",
    "analytics"
  ],
  "author": "Sanja Mandic",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.8.0",
    "jsdom": "^29.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
